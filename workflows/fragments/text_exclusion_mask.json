{
  "_meta": {
    "name": "text_exclusion_mask",
    "description": "Text exclusion mask fragment for latent space text area protection",
    "required_node_types": ["LoadImage", "SetLatentNoiseMask"]
  },
  "_attach": {
    "point": "latent",
    "output_node": "20",
    "output_slot": 0
  },
  "graph": {
    "10": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{text_exclusion_mask_path}}"
      }
    },
    "20": {
      "class_type": "SetLatentNoiseMask",
      "inputs": {
        "samples": ["ATTACHMENT_PREVIOUS", 0],
        "mask": ["10", 1]
      }
    }
  }
}
