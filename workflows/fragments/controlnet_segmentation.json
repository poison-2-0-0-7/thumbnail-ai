{
  "_meta": {
    "name": "controlnet_segmentation",
    "description": "Segmentation map ControlNet conditioning fragment (dormant, ready for activation)",
    "required_node_types": ["LoadImage", "ControlNetLoader", "ControlNetApply"]
  },
  "_attach": {
    "point": "positive_conditioning",
    "output_node": "30",
    "output_slot": 0,
    "requires": ["segmentation_path"]
  },
  "graph": {
    "10": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{segmentation_map_path}}"
      }
    },
    "20": {
      "class_type": "ControlNetLoader",
      "inputs": {
        "control_net_name": "{{resolved_segmentation_controlnet}}"
      }
    },
    "30": {
      "class_type": "ControlNetApply",
      "inputs": {
        "conditioning": ["ATTACHMENT_PREVIOUS", 0],
        "control_net": ["20", 0],
        "image": ["10", 0],
        "strength": "{{controlnet_segmentation_strength}}"
      }
    }
  }
}
