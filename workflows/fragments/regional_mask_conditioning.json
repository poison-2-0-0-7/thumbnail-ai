{
  "_meta": {
    "name": "regional_mask_conditioning",
    "description": "Per-layer spatial mask conditioning fragment",
    "required_node_types": ["LoadImage", "ConditioningSetMask"]
  },
  "_attach": {
    "point": "positive_conditioning",
    "output_node": "20",
    "output_slot": 0
  },
  "graph": {
    "10": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{person_mask_path}}"
      }
    },
    "20": {
      "class_type": "ConditioningSetMask",
      "inputs": {
        "conditioning": ["ATTACHMENT_PREVIOUS", 0],
        "mask": ["10", 1],
        "strength": 1.0,
        "set_cond_area": "default"
      }
    }
  }
}
